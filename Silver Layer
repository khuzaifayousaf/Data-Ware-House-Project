------Now Second Table Cleansing
insert into [silver].[crm_prd_info] (prd_id,cat_key,
			prd_key,prd_nm,prd_cost,prd_line,prd_start_dt,
			prd_end_dt)
select
p.prd_id,
replace(SUBSTRING(trim(p.prd_key),1,5),'-','_') as cat_key,
SUBSTRING(trim(p.prd_key),7,len(p.prd_key)) as prd_key,
trim(p.prd_nm) as prd_nm,
coalesce(p.prd_cost,0) as prd_cost,
case 
	when upper(p.prd_line) = 'R' then 'Road'
	when upper(p.prd_line) = 'S' then 'Other Sales'
	when upper(p.prd_line) = 'M' then 'Mountain'
	when upper(p.prd_line) = 'T' then 'Touring'
	else 'n/a'
end as prd_line,
cast(p.prd_start_dt as date) as prd_start_dt,
cast(LEAD(prd_start_dt) over (partition by p.prd_key
	order by prd_start_dt)as date) as prd_end_dt
from bronze.crm_prd_info as p
order by p.prd_id asc
;
goinsert into silver.crm_sales_details (
sls_ord_num,sls_prd_key,sls_cust_id
,sls_order_dt,sls_ship_dt,sls_due_dt,
sls_sales,sls_quantity,sls_price)
select
trim(d.sls_ord_num) as sls_ord_num,
trim(d.sls_prd_key) as sls_prd_key,
d.sls_cust_id,
case 
	when d.sls_order_dt = 0 or len(d.sls_order_dt)<>8
	then null
	else cast(cast(d.sls_order_dt as varchar)
			as date)
end as sls_order_dt,
case 
	when d.sls_ship_dt = 0 or 
	len(d.sls_order_dt)<>8 then null
	else cast(cast(d.sls_ship_dt as varchar)
			as date)
end as sls_ship_dt,
case 
	when d.sls_due_dt = 0 or len(d.sls_order_dt)<>8
	then null
	else cast(cast(d.sls_due_dt as varchar)
			as date)
end as sls_due_dt,
case when sls_sales <> (sls_quantity*abs(sls_price))
or sls_price is null or sls_price<0
or sls_quantity is null or sls_quantity<0
then sls_quantity*abs(sls_price)
else sls_sales
end sls_sales,
sls_quantity,
case 
	when sls_price = 0 or sls_price<0
	then sls_sales/nullif(sls_quantity,0)
else sls_price
end sls_price
from bronze.crm_sales_details as d
;
