-----Data Cleansing Process
insert into [silver].[crm_cust_info] (cst_id,cst_key,
		cst_firstname,cst_lastname,cst_marital_status,
		cst_gndr,cst_create_date)
select*
from (select
t.cst_id,
t.cst_key,
trim(t.cst_firstname) as cst_firstname,
trim(t.cst_lastname) as cst_lastname,
case when upper(t.cst_marital_status)='M' then 'Married'
	when upper(t.cst_marital_status)='S' then 'Single'
	else 'n/a'
end as cst_marital_status,
case when upper(t.cst_gndr)='M' then 'Male'
	when upper(t.cst_gndr)='S' then 'Female'
	else 'n/a'
end as cst_gndr,
t.cst_create_date
from (
select*,
ROW_NUMBER() over (partition by cst_id order by
	cst_create_date)as Unique_Value
from bronze.crm_cust_info
)t
where Unique_Value = 1 and 
		cst_id  is not null
)h 
order by h.cst_id asc;
go

